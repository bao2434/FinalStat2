train_clean <- train_data %>%
mutate(
# Transformation supported by EDA
LogAge = log(Age), Water2 = Water^2,
# Zero-presence indicators
SlagPresent = as.integer(BlastFurnaceSlag > 0),
FlyAshPresent = as.integer(FlyAsh > 0),
SuperplasticizerPresent =
as.integer(Superplasticizer > 0)
) %>%
select(-Age)
test_clean <- test_data %>%
mutate(
LogAge = log(Age), Water2 = Water^2,
SlagPresent = as.integer(BlastFurnaceSlag > 0),
FlyAshPresent = as.integer(FlyAsh > 0),
SuperplasticizerPresent =
as.integer(Superplasticizer > 0)
) %>%
select(-Age)
clean_predictors <- setdiff(
names(train_clean),
response
)
x_train_raw <- as.matrix(
train_clean[, clean_predictors, drop = FALSE]
)
x_test_raw <- as.matrix(
test_clean[, clean_predictors, drop = FALSE]
)
# Keep response on the original MPa scale
y_train <- train_clean[[response]]
y_test <- test_clean[[response]]
foldid <- make_foldid(
n = nrow(train_clean),
k = 5L,
seed = seeds$cv
)
train_clean_binary <- train_data %>%
mutate(
# Transformation supported by EDA
LogAge = log(Age), Water2 = Water^2,
# Replace zero-heavy continuous variables by binary indicators
BlastFurnaceSlag = as.integer(BlastFurnaceSlag > 0),
FlyAsh = as.integer(FlyAsh > 0),
Superplasticizer = as.integer(Superplasticizer > 0)
) %>%
select(-Age)
test_clean_binary <- test_data %>%
mutate(
LogAge = log(Age), Water2 = Water^2,
BlastFurnaceSlag = as.integer(BlastFurnaceSlag > 0),
FlyAsh = as.integer(FlyAsh > 0),
Superplasticizer = as.integer(Superplasticizer > 0)
) %>%
select(-Age)
binary_predictors <- setdiff(
names(train_clean_binary),
response
)
x_train_binary <- as.matrix(
train_clean_binary[, binary_predictors, drop = FALSE]
)
x_test_binary <- as.matrix(
test_clean_binary[, binary_predictors, drop = FALSE]
)
# Keep response on original MPa scale
y_train_binary <- train_clean_binary[[response]]
y_test_binary <- test_clean_binary[[response]]
foldid_binary <- make_foldid(
n = nrow(train_clean_binary),
k = 5L,
seed = seeds$cv
)
