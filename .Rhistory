)
library(patchwork)
compare_transform <- function(data, raw_var, transformed_var, transformed_name) {
# Original variable
p_raw <- ggplot(
data,
aes(x = .data[[raw_var]], y = Strength)
) +
geom_point(alpha = 0.3) +
geom_smooth(
method = "lm",
se = FALSE,
color = "red",
linewidth = 0.8
) +
geom_smooth(
method = "loess",
se = FALSE,
color = "blue",
linewidth = 0.8
) +
labs(
title = paste("Original:", raw_var),
x = raw_var,
y = "Concrete Compressive Strength (MPa)"
) +
theme_minimal(base_size = 11) +
theme(
plot.title = element_text(
hjust = 0.5,
face = "bold"
)
)
# Transformed variable
temp_data <- data
temp_data$Transformed <- transformed_var
p_trans <- ggplot(
temp_data,
aes(x = Transformed, y = Strength)
) +
geom_point(alpha = 0.3) +
geom_smooth(
method = "lm",
se = FALSE,
color = "red",
linewidth = 0.8
) +
geom_smooth(
method = "loess",
se = FALSE,
color = "blue",
linewidth = 0.8
) +
labs(
title = paste("Transformed:", transformed_name),
x = transformed_name,
y = "Concrete Compressive Strength (MPa)"
) +
theme_minimal(base_size = 11) +
theme(
plot.title = element_text(
hjust = 0.5,
face = "bold"
)
)
# Combine plots
combined_plot <- p_raw + p_trans +
plot_annotation(
title = paste(
"Effect of Transformation:",
raw_var
),
subtitle = "Red: Linear fit | Blue: LOESS smooth",
theme = theme(
plot.title = element_text(
hjust = 0.5,
face = "bold",
size = 14
),
plot.subtitle = element_text(
hjust = 0.5,
size = 10
)
)
)
return(combined_plot)
}
# Age
print(
compare_transform(
train_data,
"Age",
log(train_data$Age),
"log(Age)"
)
)
