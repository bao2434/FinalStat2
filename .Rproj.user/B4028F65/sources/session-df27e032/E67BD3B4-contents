fit_cv_ols <- function(x, y, foldid) {

  folds <- sort(unique(foldid))

  fold_metrics <- vector("list", length(folds))

  for (i in seq_along(folds)) {

    train_index <- foldid != folds[i]
    valid_index <- foldid == folds[i]

    train_data <- data.frame(
      y = y[train_index],
      x[train_index, , drop = FALSE]
    )

    valid_data <- data.frame(
      x[valid_index, , drop = FALSE]
    )

    fit <- lm(
      y ~ .,
      data = train_data
    )

    prediction <- predict(
      fit,
      newdata = valid_data
    )

    fold_metrics[[i]] <- score_regression(
      y = y[valid_index],
      prediction = prediction
    )
  }

  fold_metrics <- do.call(rbind, fold_metrics)

  list(
    fold_metrics = fold_metrics,
    cv_metrics = colMeans(fold_metrics)
  )
}

ols_stepwise_regression <- function(x_train,
                                    y_train,
                                    direction = "both") {
  
  df <- as.data.frame(x_train)
  df$y <- y_train
  
  full_model <- lm(
    y ~ .,
    data = df
  )
  
  best_model <- step(
    full_model,
    direction = direction,
    trace = 0
  )
  
  return (best_model)
}

fit_cv_regularized <- function(x,
                               y,
                               alpha,
                               lambda,
                               foldid) {

  folds <- sort(unique(foldid))

  fold_metrics <- vector("list", length(folds))

  for (i in seq_along(folds)) {

    train_index <- foldid != folds[i]
    valid_index <- foldid == folds[i]

    fit <- glmnet::glmnet(
      x = x[train_index, , drop = FALSE],
      y = y[train_index],
      alpha = alpha,
      lambda = lambda,
      standardize = FALSE,
      intercept = TRUE
    )

    prediction <- predict(
      fit,
      newx = x[valid_index, , drop = FALSE],
      s = lambda
    )

    fold_metrics[[i]] <- score_regression(
      y = y[valid_index],
      prediction = prediction
    )
  }

  fold_metrics <- do.call(rbind, fold_metrics)

  list(
    fold_metrics = fold_metrics,
    cv_metrics = colMeans(fold_metrics)
  )
}

coefficient_norm <- function(fit, s = NULL) {

  if (inherits(fit, "lm")) {

    beta <- coef(fit)[-1]

  } else {

    beta <- as.numeric(
      coef(fit, s = s)
    )[-1]
  }

  sqrt(sum(beta^2))
}

evaluate_cv_seed <- function(seed){

  foldid <- make_foldid(
    n = nrow(x_train),
    k = 5L,
    seed = seed
  )

  ## OLS
  ols_cv <- fit_cv_ols(
    x_train,
    y_train,
    foldid
  )

  ## Ridge

  ridge <- fit_cv_glmnet(
    x_train,
    y_train,
    alpha = 0,
    foldid = foldid
  )

  ridge_cv <- fit_cv_regularized(
    x_train,
    y_train,
    alpha = 0,
    lambda = ridge$lambda.min,
    foldid = foldid
  )

  ## Lasso

  lasso <- fit_cv_glmnet(
    x_train,
    y_train,
    alpha = 1,
    foldid = foldid
  )

  lasso_cv <- fit_cv_regularized(
    x_train,
    y_train,
    alpha = 1,
    lambda = lasso$lambda.min,
    foldid = foldid
  )

  tibble::tibble(

    Seed = seed,

    OLS_RMSE =
      ols_cv$cv_metrics["RMSE"],

    Ridge_RMSE =
      ridge_cv$cv_metrics["RMSE"],

    Lasso_RMSE =
      lasso_cv$cv_metrics["RMSE"]

  )
}

